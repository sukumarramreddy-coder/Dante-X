# Never commit real credentials.
DANTEX_ENV=development
DANTEX_MAX_INTRADAY_RISK_INR=1000
DANTEX_ALLOWED_ASSET_CLASSES=index,index_option,equity,equity_option,currency,currency_option
# Add read-only market-data provider credentials locally when adapters are enabled.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_ACCESS_TOKEN=
