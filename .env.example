# Dante X defaults to shadow mode. Never commit real credentials.
DANTEX_MODE=shadow
DANTEX_DB=dantex.db
DANTEX_MAX_DAILY_LOSS=1000

# Upstox read-only market data provider.
# Populate locally/runtime only. Do not paste secrets into source control.
UPSTOX_ACCESS_TOKEN=
# Preferred read-only credential when Analytics access is enabled.
UPSTOX_ANALYTICS_TOKEN=

# Validation defaults to temporary storage, never durable calibration evidence.
DANTEX_VALIDATION_DB=/tmp/dantex-validation.sqlite3
# Enable only for an operator-verified persistent volume; /tmp remains excluded.
DANTEX_VALIDATION_DURABLE=false
DANTEX_VALIDATION_REST_URL=
DANTEX_VALIDATION_REST_KEY=

# Dedicated restart-safe calibration state. A persistent volume is required
# before the automatic 30-session gate can publish manual signals.
DANTEX_LEARNING_DB=/tmp/dantex-learning.sqlite3
DANTEX_LEARNING_DURABLE=false
# Web server's engine URL (not a broker/order endpoint).
DANTEX_ENGINE_URL=http://localhost:8000
